# Copy to .env.local. Full walkthrough: docs/SETUP.md
APP_URL=http://localhost:3000
# Any Postgres 16+ (Aiven, Neon, local). Tables live in the "fieldquote" schema.
DATABASE_URL=
# Optional but recommended in production: the provider's CA certificate (PEM,
# newlines escaped as \n) so the server certificate is verified.
DATABASE_CA_CERT=
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
# AI provider, model and API key are chosen per company in Settings.
HOLLIS_DEMO_EMAIL=
HOLLIS_DEMO_PASSWORD=
GREENFIELD_DEMO_EMAIL=
GREENFIELD_DEMO_PASSWORD=
# Optional approver account (cannot change rates)
SHAZ_DEMO_EMAIL=
SHAZ_DEMO_PASSWORD=
# Development only: allow mail servers on this machine (e.g. a local test server).
# Ignored in production.
MAIL_ALLOW_PRIVATE_HOSTS=
